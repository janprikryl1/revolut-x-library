{
    "name": "janprikryl/revolutx",
    "description": "PHP SDK for the Revolut X Crypto Exchange REST API (v1.0)",
    "version": "0.0.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Přikryl",
            "email": "honza.prikryl.hp@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "RevolutX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RevolutX\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true
    }
}
